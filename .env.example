# Authentik OIDC
OIDC_ISSUER=https://auth.example.com/application/o/capture-viewer/
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=https://capture.example.com/auth/callback

# Session
SESSION_SECRET=change-me-to-a-random-string

# Admin access (comma-separated)
ADMIN_EMAILS=admin@example.com
ADMIN_GROUPS=authentik Admins

# Data storage
DATA_DIR=/app/data

# Processing
POTREE_CONVERTER_PATH=/opt/PotreeConverter/PotreeConverter
MAX_UPLOAD_SIZE=5368709120

# Site
SITE_TITLE=LiDAR Capture Viewer
SITE_DESCRIPTION=Interactive 3D LiDAR point cloud viewer
